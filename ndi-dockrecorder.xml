<?xml version="1.0"?>
<Container version="2">
  <Name>ndi-dockrecorder</Name>
  <Repository>ghcr.io/jamesdadams/ndi-recorder:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>host</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/JamesDAdams/ndi-recorder</Support>
  <Project>https://github.com/JamesDAdams/ndi-recorder</Project>
  <Overview>Headless NDI recorder with replay buffer, Stream Deck integration and Fireshare output. Exposes a web dashboard on port 3000.</Overview>
  <Category>MediaApp:Video</Category>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/JamesDAdams/ndi-recorder/main/icon.png</Icon>
  <!-- Remove device /dev/dri if your server has no Intel iGPU. -->
  <!-- Replay buffer RAM: at 1080p60 (~12 Mbps h264), 1 GB = ~11 min. 2 GB = ~22 min. Adjust size= accordingly. -->
  <ExtraParams>--device /dev/dri:/dev/dri --tmpfs /tmp/replay_buffer:size=2147483648,mode=777</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>

  <Config Name="Web UI Port" Target="3000" Default="3000" Mode="tcp" Description="Port for the web dashboard and API." Type="Port" Display="always" Required="true" Mask="false">3000</Config>

  <Config Name="Recordings directory" Target="/media" Default="/mnt/user/recordings/ndi" Mode="rw" Description="Where full recordings and clips are saved." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/recordings/ndi</Config>

  <Config Name="Data directory" Target="/app/data" Default="/mnt/user/appdata/ndi-dockrecorder/data" Mode="rw" Description="Persistent storage for settings and profiles." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/ndi-dockrecorder/data</Config>

  <Config Name="Config directory" Target="/app/config" Default="/mnt/user/appdata/ndi-dockrecorder/config" Mode="rw" Description="NDI Access Manager config directory." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/ndi-dockrecorder/config</Config>

  <Config Name="PORT" Target="PORT" Default="3000" Mode="" Description="Internal port the Node.js server listens on (must match the port above)." Type="Variable" Display="advanced" Required="false" Mask="false">3000</Config>

  <Config Name="NDI_ACCESS_IPS" Target="NDI_ACCESS_IPS" Default="" Mode="" Description="Comma-separated list of IPs allowed to access NDI streams (e.g. 192.168.1.10,192.168.1.20). Leave empty to allow all." Type="Variable" Display="always" Required="false" Mask="false"></Config>
</Container>
